---
/**
 * 首頁
 *
 * 敘事順序：
 *   01 主視覺 → 02 引言（畫家是誰）→ 03 三本作品集 → 04 年譜縮時
 *   05 精選作品 → 06 最新消息 → 07 藝術評論 → 08 影像檔案 → 09 收藏
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSlider from "../components/HeroSlider.astro";
import SectionHead from "../components/SectionHead.astro";
import ArtworkCard from "../components/ArtworkCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { galleries, articlesSorted, timeline, stats, artworks, media, biography } from "../lib/content.js";

const portrait = media("/images/2026/07/14/aaa1.jpg", { fallback: 480 });

const hero = [
  { title: "山高水長　62 × 128 cm　2009", image: "/images/speasyimagegallery/albums/6/images/o004.jpg" },
  { title: "飛泉　64 × 97 cm　2008", image: "/images/speasyimagegallery/albums/6/images/m016-water-fall-200864x97cm.jpg" },
  { title: "暢敘　185 × 95 cm　1992", image: "/images/speasyimagegallery/albums/7/images/l002.jpg" },
];

const collections = galleries.filter((g) => g.counts.artwork > 0);

const featured = [
  artworks.find((a) => a.code === "M012"), // 春風又綠江南岸，最大幅
  artworks.find((a) => a.code === "M010"), // 阿里山雲海
  artworks.find((a) => a.code === "F020"), // 木棉紅點嶺南春
  artworks.find((a) => a.code === "M001"), // 月色滿江流
  artworks.find((a) => a.code === "L001"), // 梅林月色
  artworks.find((a) => a.code === "F018"), // 嶺南春色
].filter(Boolean);

const latest = articlesSorted.slice(0, 5);
const reviews = articlesSorted.filter((a) => a.category === "reviews").slice(0, 3);
const photoGalleries = galleries.filter((g) => g.counts.photo > 0);

// 年譜縮時：取幾個關鍵年份
const milestoneYears = [1928, 1949, 1950, 1957, 1960, 1961, 1973, 1983, 1984, 1988, 1994, 2006, 2008, 2011];
const milestones = milestoneYears
  .map((y) => timeline.find((t) => t.year === y))
  .filter(Boolean)
  .map((t) => ({ ...t, text: t.events[0] }));

const bioText = biography?.bodyText || "";
---

<BaseLayout
  title={null}
  description="黃磊生（1928–2011）嶺南畫派大師官方網站。收錄山水、花鳥蟲魚、書法作品、六十年創作年譜、藝術評論與展覽紀錄。"
  image={hero[0].image}
  imageAlt="黃磊生作品《山高水長》"
>
  <HeroSlider slides={hero} />

  <!-- ─────────────────────────── 02 引言 -->
  <section class="intro" id="intro">
    <div class="container intro-grid">
      <div class="intro-left" data-reveal>
        <p class="eyebrow">關於藝術家</p>
        <h2 class="intro-title">
          嶺南一脈，<br />六十年筆墨行旅
        </h2>
        <p class="intro-text">
          黃磊生，1928 年生於廣東臺山。1949 年拜入當代宗師趙少昂門下，
          精研花卉、山水、人物、走獸，並以撞粉、撞水、撞色技法開出新格。
          1960 年遷居美國，於舊金山創辦國風藝苑，此後二十餘年巡展於美洲、歐洲、亞洲各大美術館與大學，
          以畫筆宣揚中華文化。1983 年返臺，任中國文化大學美術系專任教授。
        </p>
        <div class="intro-stats">
          <div class="stat">
            <span class="stat-num">{stats.artworks}</span>
            <span class="stat-label">件作品數位典藏</span>
          </div>
          <div class="stat">
            <span class="stat-num">{stats.timelineYears}</span>
            <span class="stat-label">個年份的創作與行旅紀錄</span>
          </div>
          <div class="stat">
            <span class="stat-num">{stats.articles}</span>
            <span class="stat-label">篇報導與評論</span>
          </div>
        </div>
        <a href="/about" class="btn btn--ghost">閱讀生平與畫歷</a>
      </div>

      <div class="intro-right" data-reveal>
        <div class="intro-portrait">
          {portrait && (
            <img
              src={portrait.src}
              srcset={portrait.srcset}
              sizes="(max-width: 900px) 60vw, 320px"
              alt="黃磊生於畫室"
              width={portrait.width}
              height={portrait.height}
              loading="lazy"
              decoding="async"
            />
          )}
          <p class="intro-caption">黃磊生於畫室</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────── 03 三本作品集 -->
  <section class="collections">
    <div class="container">
      <SectionHead
        eyebrow="作品集"
        title="山水 · 花鳥蟲魚 · 書法"
        lede="三本作品集，共 80 件作品。每一件皆標註編號、尺寸與創作年份，可依原作比例檢視。"
        action={{ label: "全部作品", href: "/collection" }}
      />

      <div class="collection-grid">
        {collections.map((g, i) => {
          const cover = g.items.find((i2) => i2.kind === "artwork");
          const cm = cover ? media(cover.src, { fallback: 960 }) : null;
          return (
            <a class="collection-card" href={g.route} data-reveal style={`--i:${i}`}>
              <div class="collection-media">
                {cm && (
                  <img
                    src={cm.src}
                    srcset={cm.srcset}
                    sizes="(max-width: 700px) 92vw, 32vw"
                    alt={`${g.title}作品集`}
                    loading="lazy"
                    decoding="async"
                    width={cm.width}
                    height={cm.height}
                  />
                )}
                <span class="collection-count">{g.count} 件</span>
              </div>
              <div class="collection-body">
                <h3 class="collection-title">{g.title}</h3>
                <p class="collection-en">{g.en}</p>
                <p class="collection-blurb">{g.blurb}</p>
                <span class="collection-more">
                  進入作品集
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ─────────────────────────── 04 年譜縮時 -->
  <section class="chronology">
    <div class="container">
      <SectionHead
        eyebrow="年譜"
        title="一個畫家的時間軸"
        lede={`從 1928 年出生到 2011 年辭世，${stats.timelineYears} 個年份，記錄展覽、講學、出版與獲獎。`}
        action={{ label: "完整年譜", href: "/about/chronology" }}
      />

      <ol class="timeline-strip">
        {milestones.map((m, i) => (
          <li class="tl-item" data-reveal style={`--i:${i}`}>
            <span class="tl-year">{m.year}</span>
            <span class="tl-dot" aria-hidden="true"></span>
            <p class="tl-text">{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─────────────────────────── 05 精選作品 -->
  <section class="featured">
    <div class="container">
      <SectionHead
        eyebrow="精選"
        title="六件代表作品"
        lede="從丈二巨製到盈尺小品，山水與花鳥各見其筆墨主張。"
        action={{ label: "作品索引（按年）", href: "/collection/years" }}
      />
      <div class="featured-grid">
        {featured.map((a, i) => (
          <div data-reveal style={`--i:${i}`}>
            <ArtworkCard item={a} sizes="(max-width: 640px) 90vw, (max-width: 1100px) 45vw, 360px" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────────────────── 06 最新消息 -->
  <section class="latest">
    <div class="container latest-grid">
      <div>
        <SectionHead
          eyebrow="本站消息"
          title="最新紀錄"
          action={{ label: "全部消息", href: "/news" }}
        />
        <div class="latest-list">
          {latest.map((a) => <ArticleCard article={a} />)}
        </div>
      </div>

      <aside class="latest-side">
        <div class="side-block" data-reveal>
          <h2 class="side-title">分類</h2>
          <ul class="cat-list">
            {["memorial", "exhibition", "auction", "media", "official"].map((id) => {
              const meta = { memorial: ["紀念展", "/news/memorial-exhibition"], exhibition: ["展覽新聞", "/news/exhibition-news"], auction: ["拍賣新聞", "/news/auction-news"], media: ["媒體報導", "/news/media-coverage"], official: ["官方報導", "/news/official-reports"] }[id];
              const count = articlesSorted.filter((a) => a.category === id).length;
              return (
                <li>
                  <a href={meta[1]}>
                    <span>{meta[0]}</span>
                    <span class="cat-count">{String(count).padStart(2, "0")}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>

        {reviews.length > 0 && (
          <div class="side-block" data-reveal>
            <h2 class="side-title">藝術評論</h2>
            <ul class="review-list">
              {reviews.map((r) => (
                <li>
                  <a href={r.route}>
                    <span class="review-title">{r.title}</span>
                    <span class="review-meta">{r.categoryName} · {r.eventDate?.year ?? ""}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="side-more" href="/art-reviews">全部評論 →</a>
          </div>
        )}
      </aside>
    </div>
  </section>

  <!-- ─────────────────────────── 07 影像檔案 -->
  <section class="archive">
    <div class="container">
      <SectionHead
        eyebrow="影像檔案"
        title="展覽、交流與生活"
        lede="37 幀歷史照片，記錄自 1956 年首次個展以來的展覽現場，以及與趙少昂、張大千、關山月等人的往來。"
        action={{ label: "藝術生活", href: "/life" }}
      />
      <div class="archive-grid">
        {photoGalleries.map((g, i) => {
          const covers = g.items.slice(0, 3);
          return (
            <a class="archive-card" href={g.route} data-reveal style={`--i:${i}`}>
              <div class="archive-collage">
                {covers.map((c) => {
                  const cm = media(c.src, { fallback: 480 });
                  return cm ? (
                    <img
                      src={cm.variants[0].file}
                      srcset={cm.srcset}
                      sizes="(max-width: 700px) 30vw, 14vw"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width={cm.width}
                      height={cm.height}
                    />
                  ) : null;
                })}
              </div>
              <div class="archive-body">
                <h3>{g.title}</h3>
                <p>{g.en} · {g.count} 幀</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ─────────────────────────── 08 繪畫觀引言 -->
  <section class="quote-band">
    <div class="container">
      <blockquote data-reveal>
        <p>
          「我可以有嶺南畫派專長的挺拔筆鋒，我也能有北方畫派的雄渾氣勢；
          我愛山水的空靈，也愛花鳥的生趣。」
        </p>
        <footer>
          <cite>黃磊生</cite>
          <span>〈我的繪畫觀〉</span>
        </footer>
      </blockquote>
      <a href="/about/painting-view" class="btn btn--ghost">讀全文</a>
    </div>
  </section>

  <!-- ─────────────────────────── 09 收藏 -->
  <section class="acquire">
    <div class="container acquire-inner">
      <div>
        <p class="eyebrow">收藏與授權</p>
        <h2 class="acquire-title">作品典藏、展覽合作與圖像授權</h2>
        <p class="acquire-text">
          本館受理作品收藏諮詢、展覽借展與出版圖像授權。若需高解析度圖檔、作品履歷或展覽洽談，請與館方聯繫。
        </p>
      </div>
      <div class="acquire-actions">
        <a href="/contact" class="btn">聯絡館方</a>
        <a href="mailto:muti@rumotan.asia" class="btn btn--ghost">muti@rumotan.asia</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── 02 引言 ────────────────────────────────────────── */
  .intro {
    padding: var(--s-10) 0 var(--s-9);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--s-8);
    align-items: center;
  }
  .intro-title {
    font-family: var(--serif-zh);
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.1em;
    margin: 0 0 1.5rem;
  }
  .intro-text {
    max-width: 30em;
    font-size: 0.96rem;
    line-height: 2.15;
    color: var(--ink-muted);
    margin-bottom: 2rem;
  }
  .intro-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.4rem;
    padding: 1.5rem 0;
    margin-bottom: 2rem;
    border-top: 1px solid var(--paper-edge);
    border-bottom: 1px solid var(--paper-edge);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .stat-num {
    font-family: var(--serif-en);
    font-size: 2.1rem;
    line-height: 1;
    color: var(--ochre);
    letter-spacing: 0.02em;
  }
  .stat-label {
    font-family: var(--sans-zh);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }

  .intro-portrait {
    position: relative;
  }
  .intro-portrait img {
    width: 100%;
    height: auto;
    filter: saturate(0.92) contrast(1.02);
    box-shadow: var(--shadow-lg);
  }
  .intro-portrait::before {
    content: "";
    position: absolute;
    inset: -1.1rem -1.1rem 1.1rem 1.1rem;
    border: 1px solid var(--ochre-line);
    z-index: -1;
  }
  .intro-caption {
    margin: 0.8rem 0 0;
    font-family: var(--sans-zh);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
    text-align: right;
  }

  /* ── 03 作品集 ──────────────────────────────────────── */
  .collections {
    padding: var(--s-9) 0;
    background: var(--paper-warm);
    border-top: 1px solid var(--paper-edge);
    border-bottom: 1px solid var(--paper-edge);
  }
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 3vw, 2.4rem);
  }
  .collection-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--paper);
    border: 1px solid color-mix(in srgb, var(--paper-edge) 70%, transparent);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .collection-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--ochre-line);
  }
  .collection-media {
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--paper-deep);
  }
  .collection-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1000ms var(--ease-out);
  }
  .collection-card:hover .collection-media img {
    transform: scale(1.04);
  }
  .collection-count {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    padding: 0.2rem 0.65rem;
    background: color-mix(in srgb, var(--ink) 72%, transparent);
    backdrop-filter: blur(4px);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }
  .collection-body {
    padding: 1.5rem 1.4rem 1.6rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .collection-title {
    font-family: var(--serif-zh);
    font-size: 1.45rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    margin: 0;
  }
  .collection-en {
    font-family: var(--serif-en);
    font-size: 0.74rem;
    font-style: italic;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0.25rem 0 0.9rem;
  }
  .collection-blurb {
    font-size: 0.85rem;
    line-height: 1.9;
    color: var(--ink-muted);
    margin: 0 0 1.3rem;
    flex: 1;
  }
  .collection-more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--sans-zh);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--ochre);
  }
  .collection-more svg {
    transition: transform var(--dur) var(--ease);
  }
  .collection-card:hover .collection-more svg {
    transform: translateX(4px);
  }

  /* ── 04 年譜 ────────────────────────────────────────── */
  .chronology {
    padding: var(--s-10) 0 var(--s-9);
  }
  .timeline-strip {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0;
    margin-top: var(--s-7);
  }
  .timeline-strip::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 3.05rem;
    height: 1px;
    background: var(--paper-edge);
  }
  .tl-item {
    position: relative;
    padding: 0 1.2rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .tl-year {
    font-family: var(--serif-en);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    color: var(--ink);
  }
  .tl-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ochre);
    box-shadow: 0 0 0 4px var(--paper);
  }
  .tl-text {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.8;
    color: var(--ink-muted);
    max-width: 22em;
  }

  /* ── 05 精選 ────────────────────────────────────────── */
  .featured {
    padding: var(--s-9) 0;
    background: var(--paper-warm);
    border-block: 1px solid var(--paper-edge);
  }
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3.5vw, 3rem) clamp(1.25rem, 2.5vw, 2rem);
  }

  /* ── 06 最新 ────────────────────────────────────────── */
  .latest {
    padding: var(--s-10) 0 var(--s-9);
  }
  .latest-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--s-8);
    align-items: start;
  }
  .latest-list {
    display: flex;
    flex-direction: column;
  }
  .latest-side {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    padding-left: var(--s-6);
    border-left: 1px solid var(--paper-edge);
  }
  .side-title {
    font-family: var(--sans-zh);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 1rem;
  }
  .cat-list {
    display: grid;
  }
  .cat-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px dotted color-mix(in srgb, var(--paper-edge) 85%, transparent);
    font-size: 0.88rem;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color var(--dur) var(--ease), padding-left var(--dur) var(--ease);
  }
  .cat-list a:hover {
    color: var(--ochre);
    padding-left: 0.35rem;
  }
  .cat-count {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
  }
  .review-list {
    display: grid;
    gap: 1rem;
  }
  .review-list a {
    display: grid;
    gap: 0.3rem;
    text-decoration: none;
  }
  .review-title {
    font-family: var(--serif-zh);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--ink-soft);
    transition: color var(--dur) var(--ease);
  }
  .review-list a:hover .review-title {
    color: var(--ochre);
  }
  .review-meta {
    font-family: var(--sans-zh);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }
  .side-more {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--sans-zh);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--ochre);
    text-decoration: none;
  }

  /* ── 07 影像檔案 ────────────────────────────────────── */
  .archive {
    padding: var(--s-9) 0;
    background: var(--paper-warm);
    border-block: 1px solid var(--paper-edge);
  }
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 3vw, 2.2rem);
  }
