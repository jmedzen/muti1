---
import BaseLayout from "../layouts/BaseLayout.astro";
import { articlesSorted } from "../lib/content.js";

const recent = articlesSorted.slice(0, 4);
---

<BaseLayout title="找不到頁面" description="這個頁面不存在。" noindex={true}>
  <section class="nf">
    <div class="container nf-inner">
      <p class="nf-code">404</p>
      <h1 class="nf-title">這個頁面不在館內</h1>
      <p class="nf-text">
        可能是舊網址已經搬家。原站的網址格式是 <code>/index.php/…</code>，
        新版網站改用較短的路徑；如果你手上有舊連結，多半會被自動轉到新位置。
      </p>

      <div class="nf-links">
        <a href="/" class="btn">回首頁</a>
        <a href="/collection" class="btn btn--ghost">作品</a>
        <a href="/news" class="btn btn--ghost">新聞</a>
        <a href="/search" class="btn btn--ghost">搜尋</a>
      </div>

      <div class="nf-recent">
        <p class="nf-label">最近的消息</p>
        <ul>
          {recent.map((a) => (
            <li><a href={a.route}>{a.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding: var(--s-9) 0;
    min-height: 60vh;
    display: grid;
    place-items: center;
  }
  .nf-inner {
    text-align: center;
    max-width: 34rem;
  }
  .nf-code {
    font-family: var(--serif-en);
    font-size: clamp(4rem, 12vw, 7rem);
    line-height: 0.9;
    color: var(--ochre);
    opacity: 0.22;
    margin: 0 0 0.5rem;
    letter-spacing: 0.04em;
  }
  .nf-title {
    font-family: var(--serif-zh);
    font-size: clamp(1.4rem, 3.2vw, 2rem);
    font-weight: 500;
    letter-spacing: 0.14em;
    margin: 0 0 1.2rem;
  }
  .nf-text {
    font-size: 0.9rem;
    line-height: 2.05;
    color: var(--ink-muted);
    margin: 0 0 var(--s-5);
  }
  .nf-text code {
    font-family: var(--mono);
    font-size: 0.82em;
    background: var(--paper-deep);
    padding: 0.1em 0.35em;
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  .nf-recent {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--paper-edge);
    text-align: left;
  }
  .nf-label {
    font-family: var(--sans-zh);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
    margin: 0 0 0.8rem;
  }
  .nf-recent ul {
    display: grid;
    gap: 0.5rem;
  }
  .nf-recent a {
    font-family: var(--serif-zh);
    font-size: 0.88rem;
    line-height: 1.75;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .nf-recent a:hover {
    color: var(--ochre);
  }
</style>
