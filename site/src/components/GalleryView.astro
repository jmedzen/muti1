---
/**
 * GalleryView — 作品集 / 影像檔案共用的版面
 *
 * 這個元件被 /collection/[slug].astro 與 /life/[slug].astro 共用。
 * 差別只在 kind：artwork（作品，有尺寸年份）與 photo（影像，有說明文字）。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "./Lightbox.astro";
import { galleries, media } from "../lib/content.js";

const { gallery, kind = "artwork", section = "作品" } = Astro.props;
const isArtwork = kind === "artwork";
const items = gallery.items;
const sectionHref = isArtwork ? "/collection" : "/life";

const decades = [...new Set(items.map((i) => i.eventDate?.year).filter(Boolean).map((y) => Math.floor(y / 10) * 10))].sort(
  (a, b) => a - b
);

const titleFor = isArtwork ? `${gallery.title}作品集` : gallery.title;
const descFor = `${gallery.title}（${gallery.en}）共 ${gallery.count} 件${isArtwork ? "作品" : "影像"}。${gallery.blurb}`;
const ogImg = items[0]?.src;
---

<BaseLayout title={titleFor} description={descFor} image={ogImg}>
  <header class="gal-hero">
    <div class="container">
      <nav class="crumbs" aria-label="麵包屑">
        <a href="/">首頁</a>
        <span aria-hidden="true">/</span>
        {isArtwork ? <a href="/collection">作品</a> : <a href="/life">藝術生活</a>}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{gallery.title}</span>
      </nav>

      <div class="gal-head">
        <div>
          <p class="eyebrow">{isArtwork ? "作品集" : "影像檔案"}</p>
          <h1 class="gal-title">{gallery.title}</h1>
          <p class="gal-en">{gallery.en}</p>
        </div>
        <dl class="gal-stats">
          <div><dt>件數</dt><dd>{gallery.count}</dd></div>
          {isArtwork && <div><dt>可考年份</dt><dd>{gallery.withYear}</dd></div>}
          {isArtwork && <div><dt>標註尺寸</dt><dd>{gallery.withDimensions}</dd></div>}
          {gallery.yearRange && (
            <div><dt>年份範圍</dt><dd class="range">{gallery.yearRange[0]}–{gallery.yearRange[1]}</dd></div>
          )}
        </dl>
      </div>

      <p class="gal-blurb">{gallery.blurb}</p>
    </div>
  </header>

  <!-- 工具列 -->
  <div class="gal-tools no-print">
    <div class="container tools-inner">
      <div class="tool-group">
        <button class="chip is-active" data-filter="all" aria-pressed="true">全部 <span>{items.length}</span></button>
        {decades.map((d) => {
          const n = items.filter((i) => i.eventDate?.year && Math.floor(i.eventDate.year / 10) * 10 === d).length;
          return <button class="chip" data-filter={`y${d}`} aria-pressed="false">{d}s <span>{n}</span></button>;
        })}
        {items.some((i) => i.note) && <button class="chip" data-filter="note" aria-pressed="false">附註記 <span>{items.filter((i) => i.note).length}</span></button>}
      </div>

      <div class="tool-group tool-right">
        <label class="sort-label">
          排序
          <select id="sort" aria-label="排序方式">
            <option value="order">館方原序</option>
            {isArtwork && <option value="year-desc">年份（新→舊）</option>}
            {isArtwork && <option value="year-asc">年份（舊→新）</option>}
            <option value="code">編號</option>
            {isArtwork && <option value="size-desc">尺寸（大→小）</option>}
          </select>
        </label>
        <div class="density" role="group" aria-label="顯示密度">
          <button class="dens-btn is-active" data-density="normal" aria-label="標準檢視" aria-pressed="true" title="標準檢視">
            <svg viewBox="0 0 20 20" width="15" height="15" fill="currentColor"><rect x="1" y="1" width="8" height="8" /><rect x="11" y="1" width="8" height="8" /><rect x="1" y="11" width="8" height="8" /><rect x="11" y="11" width="8" height="8" /></svg>
          </button>
          <button class="dens-btn" data-density="dense" aria-label="密集檢視" aria-pressed="false" title="密集檢視">
            <svg viewBox="0 0 20 20" width="15" height="15" fill="currentColor"><rect x="1" y="1" width="5" height="5" /><rect x="8" y="1" width="5" height="5" /><rect x="15" y="1" width="4" height="5" /><rect x="1" y="8" width="5" height="5" /><rect x="8" y="8" width="5" height="5" /><rect x="15" y="8" width="4" height="5" /><rect x="1" y="15" width="5" height="4" /><rect x="8" y="15" width="5" height="4" /><rect x="15" y="15" width="4" height="4" /></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 作品網格 -->
  <section class="gal-grid-wrap">
    <div class="container">
      <ul class="gal-grid" id="gal-grid">
        {items.map((item) => {
          const m = media(item.src, { fallback: 480 });
          const thumb = m ? m.variants[0].file : null;
          const mid = m ? m.src : null;
          const dim = item.width && item.height ? `${item.width}×${item.height}` : "";
          return (
            <li
              class="gal-item"
              data-id={item.id}
              data-year={item.eventDate?.year ?? ""}
              data-decade={item.eventDate?.year ? Math.floor(item.eventDate.year / 10) * 10 : ""}
              data-note={item.note ? "1" : "0"}
              data-order={item.order}
              data-code={item.code ?? ""}
              data-size={(item.width || 0) * (item.height || 0)}
              data-kind={item.kind}
            >
              <a class="gal-link" href={`#${item.id}`} data-lightbox={item.id} aria-label={`開啟 ${item.name ?? item.caption}`}>
                <span class="gal-frame">
                  {thumb && (
                    <img
                      src={thumb}
                      srcset={m.srcset}
                      sizes="(max-width: 600px) 46vw, (max-width: 1100px) 30vw, 260px"
                      alt={item.name ?? item.caption}
                      loading="lazy"
                      decoding="async"
                      width={m.width}
                      height={m.height}
                    />
                  )}
                  <span class="gal-hover" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4">
                      <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5L21 21M10.5 8v5M8 10.5h5" stroke-linecap="round" />
                    </svg>
                  </span>
                </span>
                <span class="gal-meta">
                  <span class="gal-name">{item.name ?? item.caption}</span>
                  {item.titleEn && <span class="gal-en-sm">{item.titleEn}</span>}
                  <span class="gal-spec">
                    {item.code && <span class="gal-code">{item.code}</span>}
                    {dim && <span>{dim}</span>}
                    {item.eventDate?.year && <span>{item.eventDate.year}</span>}
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>

      <p class="gal-empty" id="gal-empty" hidden>這個條件下沒有作品。</p>
    </div>
  </section>

  <!-- 頁尾導覽 -->
  <nav class="gal-nav no-print" aria-label="作品集導覽">
    <div class="container gal-nav-inner">
      {galleries.filter((g) => (kind === "artwork" ? g.counts.artwork > 0 : g.counts.photo > 0)).map((g) => (
        <a class:list={["gal-nav-item", { "is-current": g.slug === gallery.slug }]} href={g.route}>
          <span class="gn-title">{g.title}</span>
          <span class="gn-count">{g.count}</span>
        </a>
      ))}
    </div>
  </nav>

  <Lightbox items={items} albumTitle={gallery.title} />
</BaseLayout>

<style>
  .gal-hero {
    padding: var(--s-8) 0 var(--s-6);
    border-bottom: 1px solid var(--paper-edge);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--sans-zh);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin-bottom: 1.8rem;
  }
  .crumbs a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ochre);
  }

  .gal-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-5);
  }
  .gal-title {
    font-family: var(--serif-zh);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 500;
    letter-spacing: 0.2em;
    margin: 0;
  }
  .gal-en {
    margin: 0.4rem 0 0;
    font-family: var(--serif-en);
    font-size: 0.82rem;
    font-style: italic;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .gal-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 0;
  }
  .gal-stats div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .gal-stats dt {
    font-family: var(--sans-zh);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
  }
  .gal-stats dd {
    margin: 0;
    font-family: var(--serif-en);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--ochre);
  }
  .gal-stats dd.range {
    font-size: 1.1rem;
  }
  .gal-blurb {
    max-width: 40em;
    margin: 1.6rem 0 0;
    font-size: 0.92rem;
    line-height: 1.95;
    color: var(--ink-muted);
  }

  .gal-tools {
    position: sticky;
    top: 3.9rem;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 96%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--paper-edge);
  }
  .tools-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding-block: 0.7rem;
    min-width: 0;
  }
  .tool-group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .chip {
    padding: 0.34rem 0.75rem;
    font-family: var(--sans-zh);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    border: 1px solid transparent;
    border-radius: 999px;
    transition: all var(--dur) var(--ease);
    white-space: nowrap;
  }
  .chip span {
    font-family: var(--mono);
    font-size: 0.66rem;
    opacity: 0.55;
    margin-left: 0.3rem;
  }
  .chip:hover {
    color: var(--ochre);
    background: var(--ochre-wash);
  }
  .chip.is-active {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }
  .chip.is-active span {
    opacity: 0.7;
  }

  .tool-right {
    gap: 0.8rem;
  }
  .sort-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--sans-zh);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
  .sort-label select {
    font-family: var(--sans-zh);
    font-size: 0.74rem;
    padding: 0.3rem 1.5rem 0.3rem 0.55rem;
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--paper-edge);
    border-radius: 2px;
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink-faint) 50%),
      linear-gradient(135deg, var(--ink-faint) 50%, transparent 50%);
    background-position: calc(100% - 11px) 52%, calc(100% - 7px) 52%;
    background-size: 4px 4px, 4px 4px;
    background-repeat: no-repeat;
    cursor: pointer;
  }
  .density {
    display: flex;
    gap: 1px;
    background: var(--paper-edge);
    padding: 1px;
  }
  .dens-btn {
    width: 1.9rem;
    height: 1.9rem;
    display: grid;
    place-items: center;
    color: var(--ink-faint);
    background: var(--paper);
    transition: all var(--dur) var(--ease);
  }
  .dens-btn:hover {
    color: var(--ochre);
  }
  .dens-btn.is-active {
    background: var(--ink);
    color: var(--paper);
  }

  .gal-grid-wrap {
    padding: var(--s-6) 0 var(--s-8);
  }
  .gal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--gw, 240px), 1fr));
    gap: clamp(1.2rem, 2.4vw, 2rem) clamp(0.8rem, 1.6vw, 1.3rem);
  }
  .gal-grid.is-dense {
    --gw: 150px;
    --frame-ratio: 1 / 1;
    --frame-pad: 0.3rem;
  }

  .gal-item {
    animation: fade 400ms var(--ease) both;
  }
  .gal-item[hidden] {
    display: none;
  }
  .gal-link {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
  }
  /* 作品的「卡紙」：固定比例的框，畫作完整放進去，絕不裁切。
     美術館網站把畫裁掉是最不能被接受的事 —— 一張直幅山水被裁成正方形，
     等於毀了構圖。所以這裡用 contain + 內距，模擬裝裱的留白。
     照片（kind=photo）才用 cover，因為那些是紀錄照、沒有構圖問題。 */
  .gal-frame {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: var(--frame-ratio, 4 / 5);
    background: var(--paper-warm);
    overflow: hidden;
    padding: var(--frame-pad, 0.55rem);
  }
  .gal-item[data-kind="photo"] .gal-frame {
    aspect-ratio: 4 / 3;
    padding: 0;
  }
  .gal-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 700ms var(--ease-out), filter 400ms var(--ease);
    filter: saturate(0.98);
    box-shadow: 0 1px 3px rgba(20, 17, 13, 0.12), 0 8px 22px rgba(20, 17, 13, 0.07);
  }
  .gal-item[data-kind="photo"] .gal-frame img {
    object-fit: cover;
    box-shadow: none;
    filter: grayscale(0.25) saturate(0.95);
  }
  .gal-link:hover .gal-frame img {
    transform: scale(1.025);
    filter: saturate(1.03);
  }
  .gal-item[data-kind="photo"] .gal-link:hover .gal-frame img {
    filter: grayscale(0) saturate(1);
  }
  .gal-hover {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    place-items: center;
    height: 100%;
    background: linear-gradient(to top, rgba(20, 17, 13, 0.36), transparent 55%);
    color: var(--paper);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .gal-hover svg {
    transform: translateY(6px);
    transition: transform var(--dur) var(--ease);
  }
  .gal-link:hover .gal-hover {
    opacity: 1;
  }
  .gal-link:hover .gal-hover svg {
    transform: none;
  }

  .gal-meta {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }
  .gal-name {
    font-family: var(--serif-zh);
    font-size: 0.92rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--ink);
  }
  .gal-en-sm {
    font-family: var(--serif-en);
    font-size: 0.72rem;
    font-style: italic;
    color: var(--ink-faint);
    line-height: 1.35;
  }
  .gal-spec {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.2rem;
    font-family: var(--mono);
    font-size: 0.64rem;
    color: var(--ink-faint);
  }
  .gal-code {
    color: var(--ochre);
    letter-spacing: 0.08em;
  }
  .gal-grid.is-dense .gal-en-sm,
  .gal-grid.is-dense .gal-spec {
    display: none;
  }
  .gal-grid.is-dense .gal-name {
    font-size: 0.8rem;
  }

  .gal-empty {
    padding: var(--s-8) 0;
    text-align: center;
    font-family: var(--sans-zh);
    color: var(--ink-faint);
  }

  .gal-nav {
    border-top: 1px solid var(--paper-edge);
    background: var(--paper-warm);
    padding: var(--s-5) 0;
  }
  .gal-nav-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .gal-nav-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-family: var(--sans-zh);
    font-size: 0.8rem;
    color: var(--ink-muted);
    text-decoration: none;
    border: 1px solid transparent;
    transition: all var(--dur) var(--ease);
  }
  .gal-nav-item:hover {
    border-color: var(--ochre-line);
    color: var(--ochre);
  }
  .gal-nav-item.is-current {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .gn-count {
    font-family: var(--mono);
    font-size: 0.66rem;
    opacity: 0.6;
  }

  @media (max-width: 700px) {
    /* 手機上 240px 的自動填滿只會排出一欄，一張卡就佔掉整個螢幕，
       34 件作品要滑很久。改成兩欄，密度接近紙本的圖版索引。 */
    .gal-grid {
      --gw: 9.2rem;
    }
    .gal-grid.is-dense {
      --gw: 6.5rem;
      --frame-pad: 0.2rem;
    }
    .gal-tools {
      position: static;
    }
    .tools-inner {
      flex-direction: column;
      align-items: stretch;
    }
    .tool-group {
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 0.2rem;
      scrollbar-width: none;
      /* 關鍵：不設 min-width:0 的話 flex 子項會被內容撐寬，整頁橫向溢出 */
      min-width: 0;
      max-width: 100%;
    }
    .tools-inner {
      min-width: 0;
    }
    .tool-group::-webkit-scrollbar {
      display: none;
    }
    .tool-right {
      justify-content: space-between;
    }
    .gal-stats {
      gap: 1.4rem;
    }
  }
</style>

<script>
  (() => {
    const grid = document.getElementById("gal-grid");
    if (!grid) return;
    const items = [...grid.querySelectorAll(".gal-item")];
    const chips = [...document.querySelectorAll("[data-filter]")];
    const sortSel = document.getElementById("sort");
    const empty = document.getElementById("gal-empty");
    const densBtns = [...document.querySelectorAll("[data-density]")];

    let filter = "all";
    let sort = "order";

    const apply = () => {
      // 篩選
      let shown = 0;
      for (const el of items) {
        let ok = true;
        if (filter.startsWith("y")) {
          ok = el.dataset.decade === filter.slice(1);
        } else if (filter === "note") {
          ok = el.dataset.note === "1";
        }
        el.hidden = !ok;
        if (ok) shown++;
      }
      empty.hidden = shown > 0;

      // 排序
      const keyOf = {
        order: (el) => Number(el.dataset.order) || 0,
        "year-desc": (el) => -(Number(el.dataset.year) || 0),
        "year-asc": (el) => Number(el.dataset.year) || 9999,
        code: (el) => el.dataset.code || "zzz",
        "size-desc": (el) => -(Number(el.dataset.size) || 0),
      }[sort];
      const sorted = [...items].sort((a, b) => {
        const ka = keyOf(a);
        const kb = keyOf(b);
        if (typeof ka === "string") return ka.localeCompare(kb);
        return ka - kb;
      });
      for (const el of sorted) grid.appendChild(el);
    };

    // class 只能給眼睛看；aria-pressed 才是給讀屏軟體聽的。
    // 兩者要一起更新，否則視障使用者按了篩選不知道有沒有生效。
    chips.forEach((c) =>
      c.addEventListener("click", () => {
        chips.forEach((x) => {
          const on = x === c;
          x.classList.toggle("is-active", on);
          x.setAttribute("aria-pressed", String(on));
        });
        filter = c.dataset.filter;
        apply();
      })
    );

    sortSel?.addEventListener("change", () => {
      sort = sortSel.value;
      apply();
    });

    const setDensity = (d) => {
      grid.classList.toggle("is-dense", d === "dense");
      densBtns.forEach((b) => {
        const on = b.dataset.density === d;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-pressed", String(on));
      });
      try {
        localStorage.setItem("luisang-density", d);
      } catch {}
    };
    densBtns.forEach((b) => b.addEventListener("click", () => setDensity(b.dataset.density)));
    try {
      const saved = localStorage.getItem("luisang-density");
      if (saved === "dense") setDensity("dense");
    } catch {}
  })();
</script>
