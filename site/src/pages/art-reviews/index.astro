---
/**
 * 藝術評論 — /art-reviews
 * 9 篇評論文章的索引。
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articlesSorted, excerpt } from "../../lib/content.js";

const reviews = articlesSorted.filter((a) => a.category === "reviews");
const totalChars = reviews.reduce((s, r) => s + (r.charCount || 0), 0);
---

<BaseLayout
  title="藝術評論"
  description={`黃磊生藝術評論共 ${reviews.length} 篇，含展評、畫冊序言與學術討論。`}
>
  <header class="rev-hero">
    <div class="container">
      <nav class="crumbs" aria-label="麵包屑">
        <a href="/">首頁</a><span aria-hidden="true">/</span>
        <a href="/news">本站新聞</a><span aria-hidden="true">/</span>
        <span aria-current="page">藝術評論</span>
      </nav>
      <p class="eyebrow">Art Criticism</p>
      <h1 class="rev-title">藝術評論</h1>
      <p class="rev-lede">
        {reviews.length} 篇評論，約 {Math.round(totalChars / 1000)} 千字。
        含展覽評述、畫冊序言與嶺南畫派的學術討論，全部錄自原文。
      </p>
    </div>
  </header>

  <div class="container rev-body">
    <ol class="rev-list">
      {reviews.map((a, i) => (
        <li data-reveal style={`--i:${i}`}>
          <a href={a.route} class="rev-item">
            <span class="rev-num">{String(i + 1).padStart(2, "0")}</span>
            <span class="rev-content">
              <span class="rev-meta">
                {a.eventDate?.iso && <time datetime={a.eventDate.iso}>{a.eventDate.iso.replace(/-/g, ".")}</time>}
                {a.charCount > 0 && <span>{a.charCount} 字</span>}
              </span>
              <span class="rev-title-sm">{a.title}</span>
              {excerpt(a, 160) && <span class="rev-excerpt">{excerpt(a, 160)}</span>}
            </span>
            <span class="rev-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--sans-zh);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin-bottom: 1.8rem;
  }
  .crumbs a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ochre);
  }
  .rev-hero {
    padding: var(--s-8) 0 var(--s-6);
    border-bottom: 1px solid var(--paper-edge);
  }
  .rev-title {
    font-family: var(--serif-zh);
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 500;
    letter-spacing: 0.24em;
    margin: 0;
  }
  .rev-lede {
    max-width: 36em;
    margin: 1.4rem 0 0;
    font-size: 0.94rem;
    line-height: 2;
    color: var(--ink-muted);
  }

  .rev-body {
    padding: var(--s-7) 0 var(--s-9);
  }
  .rev-list {
    display: grid;
  }
  .rev-item {
    display: grid;
    grid-template-columns: 3.5rem 1fr 2rem;
    gap: var(--s-4);
    align-items: start;
    padding: var(--s-5) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--paper-edge) 65%, transparent);
    text-decoration: none;
    color: inherit;
    transition: padding-left var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .rev-item:hover {
    padding-left: 0.8rem;
    background: var(--ochre-wash);
  }
  .rev-num {
    font-family: var(--serif-en);
    font-size: 1.4rem;
    color: var(--ochre);
    opacity: 0.45;
    line-height: 1;
    padding-top: 0.15rem;
  }
  .rev-content {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .rev-meta {
    display: flex;
    gap: 0.8rem;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    color: var(--ink-faint);
  }
  .rev-title-sm {
    font-family: var(--serif-zh);
    font-size: 1.1rem;
    line-height: 1.7;
    letter-spacing: 0.02em;
    transition: color var(--dur) var(--ease);
  }
  .rev-item:hover .rev-title-sm {
    color: var(--ochre-deep);
  }
  .rev-excerpt {
    font-size: 0.86rem;
    line-height: 1.95;
    color: var(--ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .rev-arrow {
    color: var(--ink-faint);
    padding-top: 0.3rem;
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .rev-item:hover .rev-arrow {
    transform: translateX(4px);
    color: var(--ochre);
  }

  @media (max-width: 620px) {
    .rev-item {
      grid-template-columns: 2.2rem 1fr;
    }
    .rev-arrow {
      display: none;
    }
    .rev-excerpt {
      display: none;
    }
  }
</style>
