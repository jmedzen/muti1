---
/**
 * SiteHeader — 站頭
 *
 * 桌面：左 logo、中主選單（下拉）、右搜尋。
 * 行動：漢堡開全螢幕選單（純 CSS + 少量 JS，無框架）。
 * 捲動時變薄，但仍保持紙色底，不透明以免文字疊在圖片上看不清。
 */
import { menu, routes, SITE } from "../lib/content.js";

const nav = [
  { label: "首頁", href: "/", key: "home" },
  { label: "關於黃磊生", href: "/about", key: "about", children: [
    { label: "生平與畫歷", href: "/about" },
    { label: "年譜", href: "/about/chronology" },
    { label: "我的繪畫觀", href: "/about/painting-view" },
  ] },
  { label: "本站新聞", href: "/news", key: "news", children: [
    { label: "全部消息", href: "/news" },
    { label: "紀念展", href: "/news/memorial-exhibition" },
    { label: "展覽新聞", href: "/news/exhibition-news" },
    { label: "拍賣新聞", href: "/news/auction-news" },
    { label: "媒體報導", href: "/news/media-coverage" },
    { label: "官方報導", href: "/news/official-reports" },
  ] },
  { label: "藝術評論", href: "/art-reviews", key: "reviews" },
  { label: "作品", href: "/collection", key: "collection", children: [
    { label: "山水", href: "/collection/landscape" },
    { label: "花鳥蟲魚", href: "/collection/flowers-birds" },
    { label: "書法", href: "/collection/calligraphy" },
    { label: "作品索引（按年）", href: "/collection/years" },
  ] },
  { label: "藝術生活", href: "/life", key: "life", children: [
    { label: "展覽交流", href: "/life/exhibition-exchange" },
    { label: "藝術交流", href: "/life/art-exchange" },
    { label: "生活足跡", href: "/life/life-footprint" },
  ] },
  { label: "收藏", href: "/contact", key: "contact" },
];

const path = Astro.url.pathname;
const isActive = (item) => {
  if (!item.key) return false;
  if (item.href === "/") return path === "/";
  return path === item.href || path.startsWith(item.href + "/") || (item.children || []).some((c) => path === c.href || path.startsWith(c.href + "/"));
};
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} 首頁`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.1">
          <rect x="7.5" y="5.5" width="33" height="37" rx="0.5" />
          <path d="M7.5 33.5h33M24 9.5v20M17 15.5c2.4 3.2 2.4 7.2 0 10.4M31 15.5c-2.4 3.2-2.4 7.2 0 10.4M13.5 37.5l2.5-4M34.5 37.5l-2.5-4" stroke-linecap="round" />
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">黃磊生</span>
        <span class="brand-sub">Huang LuiSang Art Museum</span>
      </span>
    </a>

    <nav class="primary-nav" aria-label="主選單">
      <ul>
        {nav.map((item) => (
          <li class:list={{ "has-children": !!item.children, "is-active": isActive(item) }}>
            <a href={item.href} aria-current={path === item.href ? "page" : undefined}>{item.label}</a>
            {item.children && (
              <ul class="submenu">
                {item.children.map((c) => (
                  <li><a href={c.href}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href={routes.search} class="icon-btn" aria-label="搜尋">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5L21 21" stroke-linecap="round" />
        </svg>
      </a>
      <button class="icon-btn menu-toggle" aria-label="開啟選單" aria-expanded="false" aria-controls="mobile-menu">
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="行動版選單">
      {nav.map((item) => (
        <div class="mobile-group">
          <a href={item.href} class="mobile-top">{item.label}</a>
          {item.children && (
            <ul>
              {item.children.map((c) => (
                <li><a href={c.href}>{c.label}</a></li>
              ))}
            </ul>
          )}
        </div>
      ))}
      <a href={routes.search} class="mobile-top">搜尋</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--paper-edge);
    background: color-mix(in srgb, var(--paper) 97%, transparent);
  }

  .header-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: 0.85rem var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }
  .brand-mark {
    color: var(--ochre);
    display: grid;
    place-items: center;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .brand-name {
    font-family: var(--serif-zh);
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }
  .brand-sub {
    font-family: var(--serif-en);
    font-size: 0.6rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .primary-nav {
    margin-left: auto;
  }
  .primary-nav > ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }
  .primary-nav > ul > li {
    position: relative;
  }
  .primary-nav > ul > li > a {
    display: block;
    padding: 0.55rem 0.72rem;
    font-family: var(--sans-zh);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    border-radius: 2px;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .primary-nav > ul > li > a:hover {
    color: var(--ochre);
    background: var(--ochre-wash);
  }
  .primary-nav > ul > li.is-active > a {
    color: var(--ochre);
  }
  .primary-nav > ul > li.is-active > a::after {
    content: "";
    position: absolute;
    left: 0.72rem;
    right: 0.72rem;
    bottom: 0.22rem;
    height: 1px;
    background: var(--ochre);
    opacity: 0.55;
  }

  .submenu {
    position: absolute;
    top: calc(100% + 2px);
    left: 0;
    min-width: 11.5rem;
    padding: 0.5rem 0;
    background: var(--paper);
    border: 1px solid var(--paper-edge);
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: all 220ms var(--ease);
    display: grid;
  }
  .has-children:hover .submenu,
  .has-children:focus-within .submenu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .submenu a {
    display: block;
    padding: 0.48rem 1.1rem;
    font-family: var(--sans-zh);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .submenu a:hover {
    background: var(--ochre-wash);
    color: var(--ochre-deep);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.5rem;
  }
  .icon-btn {
    width: 2.35rem;
    height: 2.35rem;
    display: grid;
    place-items: center;
    color: var(--ink-muted);
    border-radius: 50%;
    text-decoration: none;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .icon-btn:hover {
    color: var(--ochre);
    background: var(--ochre-wash);
  }
  .menu-toggle {
    display: none;
  }
  .burger {
    display: grid;
    gap: 4px;
    width: 17px;
  }
  .burger i {
    height: 1.4px;
    background: currentColor;
    transition: transform 240ms var(--ease), opacity 200ms var(--ease);
  }
  .menu-toggle[aria-expanded="true"] .burger i:nth-child(1) {
    transform: translateY(5.4px) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .burger i:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded="true"] .burger i:nth-child(3) {
    transform: translateY(-5.4px) rotate(-45deg);
  }

  .mobile-menu {
    border-top: 1px solid var(--paper-edge);
    background: var(--paper);
    max-height: calc(100dvh - 4.2rem);
    overflow-y: auto;
    padding: 1rem var(--gutter) 2.5rem;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-group {
    padding: 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--paper-edge) 55%, transparent);
  }
  .mobile-top {
    display: block;
    font-family: var(--serif-zh);
    font-size: 1.06rem;
    letter-spacing: 0.1em;
    color: var(--ink);
    text-decoration: none;
    padding: 0.25rem 0;
  }
  .mobile-menu ul {
    display: grid;
    gap: 0.1rem;
    padding-left: 0.15rem;
    margin-top: 0.35rem;
  }
  .mobile-menu ul a {
    display: block;
    padding: 0.32rem 0;
    font-family: var(--sans-zh);
    font-size: 0.86rem;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .mobile-menu ul a:hover {
    color: var(--ochre);
  }

  @media (max-width: 1080px) {
    .primary-nav {
      display: none;
    }
    .menu-toggle {
      display: grid;
    }
    .header-actions {
      margin-left: auto;
    }
  }
  @media (max-width: 520px) {
    .brand-sub {
      display: none;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.querySelector(".menu-toggle");
  const mobile = document.getElementById("mobile-menu");

  const onScroll = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 8);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "開啟選單" : "關閉選單");
    if (mobile) mobile.hidden = open;
    document.body.style.overflow = open ? "" : "hidden";
  });

  // 點選單裡的錨點後自動收合
  mobile?.addEventListener("click", (e) => {
    if (e.target.closest("a")) {
      toggle?.setAttribute("aria-expanded", "false");
      if (mobile) mobile.hidden = true;
      document.body.style.overflow = "";
    }
  });

  // Esc 關閉
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      toggle.click();
    }
  });
</script>
