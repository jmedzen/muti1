{
  "name": "luisang-museum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "黃磊生藝術生命紀念館暨數位美術館 — 官方網站（重構版）",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "serve": "node ../tools/serve.mjs",
    "sync": "node ../tools/sync.mjs",
    "deploy": "npm run build && node ../tools/wrangler.mjs deploy",
    "deploy:dry": "npm run build && node ../tools/wrangler.mjs deploy --dry-run",
    "worker:dev": "node ../tools/wrangler.mjs dev"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "puppeteer-core": "^24.0.0",
    "wrangler": "^4.42.0"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  }
}
