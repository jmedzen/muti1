---
/**
 * 作品集 — /collection/landscape、/collection/flowers-birds、/collection/calligraphy
 */
import GalleryView from "../../components/GalleryView.astro";
import { galleries } from "../../lib/content.js";

export async function getStaticPaths() {
  return galleries
    .filter((g) => g.counts.artwork > 0)
    .map((g) => ({ params: { slug: g.slug }, props: { gallery: g } }));
}

const { gallery } = Astro.props;
---

<GalleryView gallery={gallery} kind="artwork" />
