---
/**
 * 藝術生活 — /life 總覽
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { galleries, media } from "../../lib/content.js";

const photoGalleries = galleries.filter((g) => g.counts.photo > 0);
const total = photoGalleries.reduce((s, g) => s + g.count, 0);
---

<BaseLayout
  title="藝術生活"
  description={`黃磊生展覽交流、藝術交流與生活足跡影像檔案，共 ${total} 幀歷史照片。`}
>
  <header class="life-hero">
    <div class="container">
      <p class="eyebrow">影像檔案</p>
      <h1 class="life-title">藝術生活</h1>
      <p class="life-lede">
        {total} 幀照片，記錄自 1956 年香港首次個展以來的展覽現場、與趙少昂、張大千、關山月諸家的往來，
        以及寫生途中與畫室日常。多數照片附有拍攝場合與年份。
      </p>
    </div>
  </header>

  <section class="life-grid-wrap">
    <div class="container">
      <div class="life-grid">
        {photoGalleries.map((g, gi) => {
          const covers = g.items.slice(0, 4);
          return (
            <a class="life-card" href={g.route} data-reveal style={`--i:${gi}`}>
              <div class="lc-collage">
                {covers.map((c, i) => {
                  const cm = media(c.src, { fallback: 480 });
                  return cm ? (
                    <img
                      src={cm.variants[0].file}
                      srcset={cm.srcset}
                      sizes="(max-width: 760px) 46vw, 22vw"
                      alt={i === 0 ? c.caption : ""}
                      loading={gi === 0 && i === 0 ? "eager" : "lazy"}
                      decoding="async"
                      width={cm.width}
                      height={cm.height}
                    />
                  ) : null;
                })}
                <span class="lc-count">{g.count} 幀</span>
              </div>
              <div class="lc-body">
                <h2 class="lc-title">{g.title}</h2>
                <p class="lc-en">{g.en}</p>
                <p class="lc-blurb">{g.blurb}</p>
                {g.yearRange && <p class="lc-range">{g.yearRange[0]} — {g.yearRange[1]}</p>}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .life-hero {
    padding: var(--s-9) 0 var(--s-7);
    border-bottom: 1px solid var(--paper-edge);
  }
  .life-title {
    font-family: var(--serif-zh);
    font-size: clamp(2.4rem, 5.5vw, 3.6rem);
    font-weight: 500;
    letter-spacing: 0.26em;
    margin: 0;
  }
  .life-lede {
    max-width: 38em;
    margin: 1.6rem 0 0;
    font-size: 0.96rem;
    line-height: 2.05;
    color: var(--ink-muted);
  }

  .life-grid-wrap {
    padding: var(--s-8) 0 var(--s-9);
  }
  .life-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
  }
  .life-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;

  }
  .lc-collage {
    position: relative;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 3px;
    aspect-ratio: 4 / 3;
    background: var(--paper-deep);
    overflow: hidden;
  }
  .lc-collage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.5) contrast(1.04);
    transition: filter 700ms var(--ease), transform 900ms var(--ease-out);
  }
  .lc-collage img:first-child {
    grid-row: span 2;
  }
  .lc-collage img:nth-child(4) {
    display: none;
  }
  .life-card:hover .lc-collage img {
    filter: grayscale(0) contrast(1);
  }
  .life-card:hover .lc-collage img:first-child {
    transform: scale(1.03);
  }
  .lc-count {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    padding: 0.2rem 0.6rem;
    background: color-mix(in srgb, var(--ink) 74%, transparent);
    backdrop-filter: blur(4px);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
  }
  .lc-body {
    padding: 1.2rem 0.2rem 0;
  }
  .lc-title {
    font-family: var(--serif-zh);
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    margin: 0;
  }
  .lc-en {
    margin: 0.2rem 0 0.75rem;
    font-family: var(--serif-en);
    font-size: 0.72rem;
    font-style: italic;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .lc-blurb {
    font-size: 0.86rem;
    line-height: 1.9;
    color: var(--ink-muted);
    margin: 0 0 0.7rem;
    max-width: 32em;
  }
  .lc-range {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--ochre);
  }

  @media (max-width: 760px) {
    .life-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
